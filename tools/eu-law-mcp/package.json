{
  "name": "eu-law-mcp",
  "version": "1.0.0",
  "description": "MCP server for accessing EU legislation via EUR-Lex, Cellar SPARQL endpoint, and the Official Journal",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test dist/tests/*.js",
    "test:dev": "tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
